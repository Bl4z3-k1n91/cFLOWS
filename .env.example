# Either paste a FreeLLMAPI key alone, or use the named form below.
# FREELLMAPI_API_KEY=replace-with-your-key
# FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
# LLM_MODEL=auto:fast

# Optional trusted telemetry snapshot. If omitted, the app shows integration-needed.
# CFLOWS_SENSOR_FEED=D:\path\to\trusted-sensor-live.json

# Optional multi-client citizen-report sync service.
# Start it with: npm run sync-server
# CFLOWS_SYNC_URL=http://127.0.0.1:8787
# CFLOWS_SYNC_TOKEN=replace-when-service-is-exposed-beyond-loopback
